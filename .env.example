# TODO[ENV-01] [A/D] API 키 설정 위치. 이 파일을 루트 .env로 복사한 뒤 키를 입력하세요.
# 시작 안내: START_HERE.md / 작업별 안내: docs/INTEGRATION_GUIDE.md
# Node 22+, Python 3.12+ 권장. 실제 키가 없는 상태에서도 DATA_PROVIDER=demo로 실행됩니다.

# TODO[APP-01] [D] 프론트엔드가 호출할 FastAPI 주소. API 키를 넣는 곳이 아닙니다.
# 빈 값이면 독립 브라우저 데모, 아래 값이면 로컬 FastAPI 사용. 변경 후 프론트엔드 재빌드.
NEXT_PUBLIC_API_URL=http://localhost:8001

# demo = 제공된 합성 데이터. file = 검증된 실제 JSON + 실제 학습 모델 필요.
# 키를 입력하는 것만으로 실제 데이터 모드로 전환되지 않습니다.
DATA_PROVIDER=demo
# 아래 경로는 backend/에서 uvicorn을 실행할 때의 상대 경로입니다.
DATASET_PATH=data/raw/live_dataset.json
DATABASE_PATH=data/basket.sqlite3
MODEL_DIR=ml/artifacts
TRAINING_DATA_PATH=data/raw/prices.csv
# 배포할 프론트엔드 주소를 허용 목록에 추가하세요.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# API-01 [A] KAMIS: 인증 ID와 인증 키를 모두 입력. 실제 호출 검증 필요.
KAMIS_CERT_ID=
KAMIS_CERT_KEY=
# API-02 [A] ECOS: 키와 별도로 공식 콘솔이 생성한 요청 URL 설정 필요.
ECOS_API_KEY=
# API-03 [A] KOSIS: 통계표·기관·항목·분류 코드를 공식 콘솔에서 확인.
KOSIS_API_KEY=
# API-04 [A] 기상청: 승인받은 서비스 URL·관측소·조회 변수 설정 필요.
WEATHER_API_KEY=
# API-05 [B] 이용 권한이 있는 뉴스 공급자의 키. 공급자별 인증 방식 설정 필요.
NEWS_API_KEY=
# AI-01 [B] NEWS_API_KEY는 뉴스 수집용입니다. NLP/LLM 연결은 아직 없으며 공급자 선택 후 별도 서버 키 설정을 추가해야 합니다.
# 실제 키는 서버에서만 사용합니다. API 키에 NEXT_PUBLIC_ 접두사를 붙이지 마세요.
