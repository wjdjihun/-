# Node 22+, Python 3.12+. Copy to .env in the project root.
# Empty URL = standalone browser-local demo. Local FastAPI = http://localhost:8001
NEXT_PUBLIC_API_URL=http://localhost:8001
DATA_PROVIDER=demo
# Paths below are relative to backend/ when running uvicorn from backend/.
DATASET_PATH=data/raw/live_dataset.json
DATABASE_PATH=data/basket.sqlite3
MODEL_DIR=ml/artifacts
TRAINING_DATA_PATH=data/raw/prices.csv
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
KAMIS_CERT_ID=
KAMIS_CERT_KEY=
ECOS_API_KEY=
KOSIS_API_KEY=
WEATHER_API_KEY=
NEWS_API_KEY=
